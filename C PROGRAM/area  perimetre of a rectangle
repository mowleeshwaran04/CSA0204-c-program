
#include <stdio.h>

int main() {
    float length, width;
    float area, perimeter;

    printf("Enter the length: \n");
    scanf("%f", &length);

    printf("Enter the width:\n ");
    scanf("%f", &width);

    area = length * width;
    perimeter = 2 * (length + width);

    printf("Area of the rectangle = %.2f\n", area);
    printf("Perimeter of the rectangle = %.2f", perimeter);

    return 0;
}
