
#include <stdio.h>

int main() {
    int n;
    int sum = 0;
    int temp;

    printf("Enter the number:\n ");
    scanf("%d", &n);

    temp = n;

    while (temp != 0) {
        int digit = temp % 10;
        sum += digit;
        temp = temp / 10;
    }

    printf("The sum of the digits is %d", sum);

    return 0;
}
