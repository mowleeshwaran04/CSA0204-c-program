
#include <stdio.h>
#include <string.h>

int main() {
    char str[50];
    int i = 0;
    int j;
    int palindrome = 1;

    printf("Enter the string: ");
    scanf("%s", str);

    j = strlen(str) - 1;

    while (i < j) {
        if (str[i] != str[j]) {
            palindrome = 0;
            break;
        }
        i++;
        j--;
    }

    if (palindrome)
        printf("It is a palindrome.");
    else
        printf("It is not a palindrome.");

    return 0;
}
