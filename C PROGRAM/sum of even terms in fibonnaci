
#include <stdio.h>

int main() {
    int n, a = 0, b = 1, c;
    int sum = 0;

    printf("Enter the number of terms: ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        printf("%d ", a);

        if (a % 2 == 0) {
            sum += a;
        }

        c = a + b;
        a = b;
        b = c;
    }

    printf("\nSum of even Fibonacci terms = %d", sum);

    return 0;
}
