#include <stdio.h>

struct student
{
    int regno;
    char name[30];
    char dept[20];
    int mark[5];
    char result;
};

int main()
{
    struct student s[5];
    int i, j, n;

    printf("Enter the number of students: ");
    scanf("%d", &n);

    // Input
    for(i = 0; i < n; i++)
    {
        printf("\nEnter Details of Student %d\n", i + 1);

        printf("Enter Register Number: ");
        scanf("%d", &s[i].regno);

        printf("Enter Name: ");
        scanf("%s", s[i].name);

        printf("Enter Department: ");
        scanf("%s", s[i].dept);

        s[i].result = 'P';

        printf("Enter Marks of 5 Subjects:\n");

        for(j = 0; j < 5; j++)
        {
            printf("Subject %d: ", j + 1);
            scanf("%d", &s[i].mark[j]);

            if(s[i].mark[j] < 50)
            {
                s[i].result = 'F';
            }
        }
    }

    // Output
    printf("\n\nStudent Details\n");
    printf("-------------------------------------------------------------------------------\n");
    printf("RegNo\tName\tDept\tM1\tM2\tM3\tM4\tM5\tResult\n");
    printf("-------------------------------------------------------------------------------\n");

    for(i = 0; i < n; i++)
    {
        printf("%d\t%s\t%s\t%d\t%d\t%d\t%d\t%d\t%c\n",
               s[i].regno,
               s[i].name,
               s[i].dept,
               s[i].mark[0],
               s[i].mark[1],
               s[i].mark[2],
               s[i].mark[3],
               s[i].mark[4],
               s[i].result);
    }

    return 0;
}
