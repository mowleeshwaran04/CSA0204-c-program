
#include <stdio.h>

int main()
{
    int arr[100], n;
    int i, j, k;

    printf("Enter the size of the array: ");
    scanf("%d", &n);

    printf("Enter the array elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    // Display Original Array
    printf("\nOriginal Array: ");
    for(i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    // Display Duplicate Elements
    printf("\nDuplicate Elements: ");
    int found = 0;

    for(i = 0; i < n; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            if(arr[i] == arr[j])
            {
                printf("%d ", arr[i]);
                found = 1;
                break;      // Print duplicate only once
            }
        }
    }

    if(found == 0)
    {
        printf("No duplicates");
    }

    // Remove Duplicates
    for(i = 0; i < n; i++)
    {
        for(j = i + 1; j < n; )
        {
            if(arr[i] == arr[j])
            {
                for(k = j; k < n - 1; k++)
                {
                    arr[k] = arr[k + 1];
                }
                n--;
            }
            else
            {
                j++;
            }
        }
    }

    // Display Revised Array
    printf("\nArray after removing duplicates: ");
    for(i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
