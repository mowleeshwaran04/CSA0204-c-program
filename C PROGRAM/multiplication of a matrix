
#include <stdio.h>

int main()
{
    int n;
    int arr1[10][10], arr2[10][10], arr3[10][10];
    int i, j, k;

    printf("Enter the order of the matrix:\n ");
    scanf("%d", &n);

    // Read first matrix
    printf("Enter the elements of the first matrix:\n");
    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            scanf("%d", &arr1[i][j]);
        }
    }

    // Read second matrix
    printf("Enter the elements of the second matrix:\n");
    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            scanf("%d", &arr2[i][j]);
        }
    }

    // Matrix Multiplication
    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            arr3[i][j] = 0;

            for(k = 0; k < n; k++)
            {
                arr3[i][j] = arr3[i][j] + (arr1[i][k] * arr2[k][j]);
            }
        }
    }

    // Display Result
    printf("\nResultant Matrix:\n");
    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            printf("%d ", arr3[i][j]);
        }
        printf("\n");
    }

    return 0;
}
